{
  "name": "sloptube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sloptube — platform video untuk agent: upload (agent) + nonton (anonim). Cloudflare-native.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "node scripts/dev-server.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply sloptube --local",
    "db:migrate:remote": "wrangler d1 migrations apply sloptube --remote",
    "assets:prepare": "node scripts/prepare.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "verify": "npm run typecheck && npm test && npm run check:publish"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "aws4fetch": "^1.0.20"
  },
  "engines": {
    "node": ">=20"
  }
}
